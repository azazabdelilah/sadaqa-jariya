{
  "number": 113,
  "name": "سُورَةُ الفَلَقِ",
  "englishName": "Al-Falaq",
  "englishNameTranslation": "The Dawn",
  "numberOfAyahs": 5,
  "revelationType": "Meccan",
  "ayahs": [
    {
      "number": 6226,
      "numberInSurah": 1,
      "juz": 30,
      "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ أَعُوذُ بِرَبِّ ٱلْفَلَقِ",
      "translation": "Say, \"I seek refuge in the Lord of daybreak"
    },
    {
      "number": 6227,
      "numberInSurah": 2,
      "juz": 30,
      "text": "مِن شَرِّ مَا خَلَقَ",
      "translation": "From the evil of that which He created"
    },
    {
      "number": 6228,
      "numberInSurah": 3,
      "juz": 30,
      "text": "وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ",
      "translation": "And from the evil of darkness when it settles"
    },
    {
      "number": 6229,
      "numberInSurah": 4,
      "juz": 30,
      "text": "وَمِن شَرِّ ٱلنَّفَّٰثَٰتِ فِى ٱلْعُقَدِ",
      "translation": "And from the evil of the blowers in knots"
    },
    {
      "number": 6230,
      "numberInSurah": 5,
      "juz": 30,
      "text": "وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ",
      "translation": "And from the evil of an envier when he envies.\""
    }
  ]
}