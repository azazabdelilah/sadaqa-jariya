{
  "number": 102,
  "name": "سُورَةُ التَّكَاثُرِ",
  "englishName": "At-Takaathur",
  "englishNameTranslation": "Competition",
  "numberOfAyahs": 8,
  "revelationType": "Meccan",
  "ayahs": [
    {
      "number": 6169,
      "numberInSurah": 1,
      "juz": 30,
      "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَلْهَىٰكُمُ ٱلتَّكَاثُرُ",
      "translation": "Competition in [worldly] increase diverts you"
    },
    {
      "number": 6170,
      "numberInSurah": 2,
      "juz": 30,
      "text": "حَتَّىٰ زُرْتُمُ ٱلْمَقَابِرَ",
      "translation": "Until you visit the graveyards."
    },
    {
      "number": 6171,
      "numberInSurah": 3,
      "juz": 30,
      "text": "كَلَّا سَوْفَ تَعْلَمُونَ",
      "translation": "No! You are going to know."
    },
    {
      "number": 6172,
      "numberInSurah": 4,
      "juz": 30,
      "text": "ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَ",
      "translation": "Then no! You are going to know."
    },
    {
      "number": 6173,
      "numberInSurah": 5,
      "juz": 30,
      "text": "كَلَّا لَوْ تَعْلَمُونَ عِلْمَ ٱلْيَقِينِ",
      "translation": "No! If you only knew with knowledge of certainty..."
    },
    {
      "number": 6174,
      "numberInSurah": 6,
      "juz": 30,
      "text": "لَتَرَوُنَّ ٱلْجَحِيمَ",
      "translation": "You will surely see the Hellfire."
    },
    {
      "number": 6175,
      "numberInSurah": 7,
      "juz": 30,
      "text": "ثُمَّ لَتَرَوُنَّهَا عَيْنَ ٱلْيَقِينِ",
      "translation": "Then you will surely see it with the eye of certainty."
    },
    {
      "number": 6176,
      "numberInSurah": 8,
      "juz": 30,
      "text": "ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ ٱلنَّعِيمِ",
      "translation": "Then you will surely be asked that Day about pleasure."
    }
  ]
}